      <Feature Id="PgmFeature"
               Title="*.pgm files"
               Description="Always use vimage to open PGM images"
               AllowAdvertise="no"
               InstallDefault="local"
               Absent="allow"
               Level="1">
        <ComponentRef Id="PgmOpenAssociation" />
      </Feature>

      <Feature Id="PpmFeature"
               Title="*.ppm files"
               Description="Always use vimage to open PPM images"
               AllowAdvertise="no"
               InstallDefault="local"
               Absent="allow"
               Level="1">
        <ComponentRef Id="PpmOpenAssociation" />
      </Feature>

      <Feature Id="TiffFeature"
               Title="*.tif and *.tiff files"
               Description="Always use vimage to open TIFF images"
               AllowAdvertise="no"
               InstallDefault="local"
               Absent="allow"
               Level="1">
        <ComponentRef Id="TifOpenAssociation" />
