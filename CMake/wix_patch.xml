      <ProgId Id="webpType" Description="WebP Image">
        <Extension Id="webp" ContentType="image/webp">
          <Verb Id="open" Command="Open" TargetProperty="FileAssociationProperty" Argument="&quot;%1&quot;" />
          <MIME ContentType="image/webp" Default="yes" />
        </Extension>
      </ProgId>
    </Component>

    <!-- Placeholder for "default viewer" registry work (still disabled) -->
    <Component Id="JpegDefaultAssociation" Directory="INSTALL_ROOT" Guid="fdca15ce-f870-4063-a271-367c508a0231">
      <CreateFolder />
      <!-- TODO: default-association registry entries if/when you want hard default -->
    </Component>

    <!-- Trick to avoid ICE69 when using TargetProperty in file associations -->
    <SetProperty Id="FileAssociationProperty" Value="[INSTALL_ROOT]vimage.exe" After="CostFinalize" />

  </CPackWiXFragment>

  <CPackWiXFragment Id="#PRODUCTFEATURE">

    <!-- Always allow "Open with vimage" for all supported types -->
    <ComponentRef Id="JpgOpenAssociation" />
    <ComponentRef Id="JpegOpenAssociation" />
    <ComponentRef Id="PngOpenAssociation" />
    <ComponentRef Id="BmpOpenAssociation" />
    <ComponentRef Id="DngOpenAssociation" />
    <ComponentRef Id="HeicOpenAssociation" />
    <ComponentRef Id="HeifOpenAssociation" />
    <ComponentRef Id="GifOpenAssociation" />
    <ComponentRef Id="MinecraftOpenAssociation" />
    <ComponentRef Id="PbmOpenAssociation" />
    <ComponentRef Id="PgmOpenAssociation" />
    <ComponentRef Id="PpmOpenAssociation" />
    <ComponentRef Id="TifOpenAssociation" />
    <ComponentRef Id="TiffOpenAssociation" />
    <ComponentRef Id="WebpOpenAssociation" />

    <!-- Optional default file-type associations (installer asks via checkboxes) -->
    <Feature Id="FiletypesFeature"
             Title="Default File Type Associations"
             Description="Use vimage to open selected image file types by default"
             Display="expand"
             AllowAdvertise="no"
             InstallDefault="local"
             Absent="allow">

      <Feature Id="JpegTypesFeature"
               Title="*.jpg and *.jpeg files"
               Description="Always use vimage to open JPEG images"
               AllowAdvertise="no"
               InstallDefault="local"
               Absent="allow"
               Level="1">
        <ComponentRef Id="JpgOpenAssociation" />
        <ComponentRef Id="JpegOpenAssociation" />
        <ComponentRef Id="JpegDefaultAssociation" />
      </Feature>

      <Feature Id="PngFeature"
               Title="*.png files"
               Description="Always use vimage to open PNG images"
               AllowAdvertise="no"
               InstallDefault="local"
               Absent="allow"
               Level="1">
        <ComponentRef Id="PngOpenAssociation" />
      </Feature>

      <Feature Id="BmpFeature"
               Title="*.bmp files"
               Description="Always use vimage to open BMP images"
               AllowAdvertise="no"
               InstallDefault="local"
               Absent="allow"
               Level="1">
        <ComponentRef Id="BmpOpenAssociation" />
      </Feature>

      <Feature Id="MinecraftFeature"
               Title="*.dat files"
               Description="Always use vimage to open Minecraft maps"
               AllowAdvertise="no"
               InstallDefault="local"
               Absent="allow"
               Level="1">
        <ComponentRef Id="MinecraftOpenAssociation" />
      </Feature>

      <Feature Id="DngFeature"
               Title="*.dng files"
               Description="Always use vimage to open DNG images"
               AllowAdvertise="no"
               InstallDefault="local"
               Absent="allow"
               Level="1">
        <ComponentRef Id="DngOpenAssociation" />
      </Feature>

      <Feature Id="HeicFeature"
               Title="*.heic files"
               Description="Always use vimage to open HEIC images"
               AllowAdvertise="no"
               InstallDefault="local"
               Absent="allow"
               Level="1">
        <ComponentRef Id="HeicOpenAssociation" />
      </Feature>

      <Feature Id="HeifFeature"
               Title="*.heif files"
               Description="Always use vimage to open HEIF images"
               AllowAdvertise="no"
               InstallDefault="local"
               Absent="allow"
               Level="1">
        <ComponentRef Id="HeifOpenAssociation" />
      </Feature>

      <Feature Id="GifFeature"
               Title="*.gif files"
               Description="Always use vimage to open GIF images"
               AllowAdvertise="no"
               InstallDefault="local"
               Absent="allow"
               Level="1">
        <ComponentRef Id="GifOpenAssociation" />
      </Feature>

      <Feature Id="PbmFeature"
               Title="*.pbm files"
               Description="Always use vimage to open PBM images"
               AllowAdvertise="no"
               InstallDefault="local"
               Absent="allow"
               Level="1">
        <ComponentRef Id="PbmOpenAssociation" />
